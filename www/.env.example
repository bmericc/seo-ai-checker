APP_NAME="SEO / AI Overview Checker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Google SERP scraping ---
GOOGLE_HL=tr
GOOGLE_GL=tr
# Istekler arasi bekleme suresi (ms) - Google tarafindan engellenmemek icin
REQUEST_DELAY_MS=4000
# Istege bagli HTTP proxy (ornek: http://user:pass@proxyhost:8080)
HTTP_PROXY=
# Istege bagli ozel User-Agent (bos birakilirsa varsayilan masaustu Chrome UA kullanilir)
SCRAPER_USER_AGENT=

# --- Lighthouse (Google PageSpeed Insights API) ---
# API anahtari olmadan da calisir ama kota cok dusuktur.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
# mobile | desktop
PSI_STRATEGY=mobile

# --- Chrome UX Report (CrUX) - gercek kullanici Core Web Vitals verisi ---
# Bos birakilirsa PSI_API_KEY kullanilir (ayni Google Cloud projesinde
# "Chrome UX Report API" da etkinlestirilmisse). Ayri bir anahtar icin:
# https://developers.google.com/web/tools/chrome-user-experience-report/api/guides/getting-started
CRUX_API_KEY=

# --- Google ile giris (erisim kontrolu + Search Console/GA4 API'leri) ---
# https://console.cloud.google.com/apis/credentials adresinden bir OAuth 2.0
# Client ID olusturun (Web application), Authorized redirect URI olarak
# GOOGLE_REDIRECT_URI degerini birebir ekleyin. Search Console ve GA4
# verisi cekebilmek icin OAuth consent screen'e "webmasters.readonly" ve
# "analytics.readonly" scope'larini eklemeniz, Search Console API ve
# Google Analytics Data API'yi projede etkinlestirmeniz gerekir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sizin-sunucunuz.com/auth/google/callback

# --- Bing Webmaster Tools - backlink verisi ---
# Sadece bu hesapta ONCEDEN DOGRULANMIS siteler icin veri doner (genel bir
# backlink indeksi degildir). https://www.bing.com/webmasters -> Settings ->
# API Access adresinden alinir.
BING_WEBMASTER_API_KEY=

# Herhangi bir Google hesabi giris yapip hesap olusturabilir; yeni hesaplar
# admin onaylayana kadar panele erisemez (bkz. /admin/users). Buradaki
# e-postalar (virgulle ayrilmis) ilk giriste OTOMATIK admin + onayli sayilir
# - yeni kurulumda kendinize erisim acmak icindir, sonrasi /admin/users'tan
# yonetilir.
ADMIN_EMAILS=ornek@gmail.com
