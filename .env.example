# Google arama arayuzu dili/bolgesi (SERP sonuclarini etkiler)
GOOGLE_HL=tr
GOOGLE_GL=tr

# Istekler arasi bekleme suresi (ms) - Google tarafindan engellenmemek icin
REQUEST_DELAY_MS=4000

# Istege bagli HTTP proxy (ornek: http://user:pass@proxyhost:8080)
HTTP_PROXY=

# Istege bagli ozel User-Agent (bos birakilirsa varsayilan masaustu Chrome UA kullanilir)
USER_AGENT=

# --- Web arayuzu ---

APP_DEBUG=false
# Uygulamanin herkese acik adresi (bilgi amacli, opsiyonel)
APP_BASE_URL=

# Veritabani (varsayilan: sqlite, sifir kurulum)
DB_DRIVER=sqlite
DB_PATH=
# MySQL kullanmak icin:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_NAME=seo_ai_checker
# DB_USER=root
# DB_PASS=secret

# --- Google ile giris (erisim kontrolu) ---
# https://console.cloud.google.com/apis/credentials adresinden bir OAuth 2.0
# Client ID olusturun (Web application), Authorized redirect URI olarak
# GOOGLE_OAUTH_REDIRECT_URI degerini birebir ekleyin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://sizin-sunucunuz.com/auth/google/callback

# Panele girisine izin verilen Google e-postalari (virgulle ayrilmis).
# Bos birakilirsa HIC KIMSE giris yapamaz.
ALLOWED_GOOGLE_EMAILS=ornek@gmail.com

# --- Lighthouse (Google PageSpeed Insights API) ---
# API anahtari olmadan da calisir ama kota dusuktur.
# https://developers.google.com/speed/docs/insights/v5/get-started adresinden alinabilir.
PSI_API_KEY=
# mobile | desktop
PSI_STRATEGY=mobile
