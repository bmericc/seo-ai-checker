# Bu dosya docker-compose (tek docker-compose.yml, hem dev hem prod)
# tarafindan okunur; "environment:" blogu buradaki degiskenleri container'a
# gercek (OS seviyesinde) ortam degiskeni olarak enjekte eder. Laravel bu
# degerleri dogrudan kullanir; Docker altinda www/.env dosyasi OKUNMAZ
# (o dosya yalnizca Docker'siz manuel kurulum icindir, bkz. README ve
# www/.env.example).
#
# Kullanim:
#   cp .env.example .env                          # yerel/dev
#   docker compose up -d
#
#   cp .env.example .env.prod                     # prod (ayni sunucuda
#   # .env.prod'u prod degerleriyle doldurun        AYNI docker-compose.yml,
#   docker compose --env-file .env.prod up -d      # farkli --env-file ile)
#
# Dev ve prod ayni cihazda calismayacagi icin volume/servis adlari
# kasitli olarak aynidir (vendor, bootstrap_cache, vs.).
#
# APP_KEY bos birakilir; asagidaki komutla uretilip buraya yapistirilir:
#   docker compose run --rm app php artisan key:generate --show

# --- Host port (docker-compose "ports" eslemesi) ---
WEB_PORT=8080

# --- Docker build/runtime davranisi ---
# Prod'da "--no-dev" verin: phpunit/pail/pint gibi gelistirme bagimliliklari
# imaja girmez. Bos birakilirsa (dev varsayilani) tum bagimliliklar kurulur.
COMPOSER_INSTALL_FLAGS=
# Prod'da "unless-stopped" verin (sunucu/daemon yeniden baslarsa container
# otomatik ayaga kalkar). Dev varsayilani "no" (elle baslat/durdur).
RESTART_POLICY=no

# --- Laravel core ---
APP_NAME="SEO / AI Overview Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Google SERP scraping ---
GOOGLE_HL=tr
GOOGLE_GL=tr
# Istekler arasi bekleme suresi (ms) - Google tarafindan engellenmemek icin
REQUEST_DELAY_MS=4000
# Istege bagli HTTP proxy (ornek: http://user:pass@proxyhost:8080)
HTTP_PROXY=
# Istege bagli ozel User-Agent (bos birakilirsa varsayilan masaustu Chrome UA kullanilir)
SCRAPER_USER_AGENT=

# --- Lighthouse (Google PageSpeed Insights API) ---
# API anahtari olmadan da calisir ama kota cok dusuktur.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
# mobile | desktop
PSI_STRATEGY=mobile

# --- Google ile giris (erisim kontrolu) ---
# https://console.cloud.google.com/apis/credentials adresinden bir OAuth 2.0
# Client ID olusturun (Web application), Authorized redirect URI olarak
# GOOGLE_REDIRECT_URI degerini birebir ekleyin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Panele girisine izin verilen Google e-postalari (virgulle ayrilmis).
# Bos birakilirsa HIC KIMSE giris yapamaz.
ALLOWED_GOOGLE_EMAILS=ornek@gmail.com
