# Bu dosya docker-compose (tek docker-compose.yml, hem dev hem prod)
# tarafindan okunur; "environment:" blogu buradaki degiskenleri container'a
# gercek (OS seviyesinde) ortam degiskeni olarak enjekte eder. Laravel bu
# degerleri dogrudan kullanir; Docker altinda www/.env dosyasi OKUNMAZ
# (o dosya yalnizca Docker'siz manuel kurulum icindir, bkz. README ve
# www/.env.example).
#
# Kullanim:
#   cp .env.docker.example .env                   # yerel/dev
#   docker compose up -d
#
#   cp .env.docker.example .env.prod              # prod (ayni sunucuda
#   # .env.prod'u prod degerleriyle doldurun        AYNI docker-compose.yml,
#   docker compose --env-file .env.prod up -d      # farkli --env-file ile)
#
# Dev ve prod ayni cihazda calismayacagi icin volume/servis adlari
# kasitli olarak aynidir (vendor, bootstrap_cache, vs.).
#
# APP_KEY bu dosyada YOK: otomatik olusturulur. Container ilk kez
# baslarken (docker/php/entrypoint.sh) www/.env'de bir anahtar yoksa
# yeni birini uretip oraya kalici olarak yazar; sonraki her yeniden
# baslatmada/olusturmada ayni anahtari kullanmaya devam eder. Belirli bir
# anahtar kullanmak isterseniz (ör. eski bir kurulumdan tasima), elle
# www/.env icindeki APP_KEY= satirini duzenleyin.

# --- Host port (docker-compose "ports" eslemesi) ---
WEB_PORT=8080

# --- Docker build/runtime davranisi ---
# Prod'da "--no-dev" verin: phpunit/pail/pint gibi gelistirme bagimliliklari
# imaja girmez. Bos birakilirsa (dev varsayilani) tum bagimliliklar kurulur.
COMPOSER_INSTALL_FLAGS=
# Prod'da "unless-stopped" verin (sunucu/daemon yeniden baslarsa container
# otomatik ayaga kalkar). Dev varsayilani "no" (elle baslat/durdur).
RESTART_POLICY=no

# --- nginx-proxy-manager (veya baska bir reverse proxy) arkasinda calisma ---
# webserver servisi, asagidaki isimde external (bu compose disinda yonetilen)
# bir Docker network'una de baglanir. Kullanmadan once BIR KEZ olusturun:
#   docker network create ${PROXY_NETWORK}
# nginx-proxy-manager'in kendi docker-compose'u da ayni network'u
# kullanmalidir (NPM kurulumlarinda genelde "external: true" ile referans
# verilir). NPM'de "Proxy Host" eklerken:
#   Forward Hostname / IP -> APP_HOSTNAME degeri
#   Forward Port          -> 80 (nginx container'in ic portu, WEB_PORT degil)
PROXY_NETWORK=npm_proxy
APP_HOSTNAME=seo-ai-checker

# --- Laravel core ---
APP_NAME="SEO / AI Overview Checker"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Google SERP scraping ---
GOOGLE_HL=tr
GOOGLE_GL=tr
# Istekler arasi bekleme suresi (ms) - Google tarafindan engellenmemek icin
REQUEST_DELAY_MS=4000
# Istege bagli HTTP proxy (ornek: http://user:pass@proxyhost:8080)
HTTP_PROXY=
# Istege bagli ozel User-Agent (bos birakilirsa varsayilan masaustu Chrome UA kullanilir)
SCRAPER_USER_AGENT=

# --- Lighthouse (Google PageSpeed Insights API) ---
# API anahtari olmadan da calisir ama kota cok dusuktur.
# https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=
# mobile | desktop
PSI_STRATEGY=mobile

# --- Google ile giris (erisim kontrolu) ---
# https://console.cloud.google.com/apis/credentials adresinden bir OAuth 2.0
# Client ID olusturun (Web application), Authorized redirect URI olarak
# GOOGLE_REDIRECT_URI degerini birebir ekleyin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Bing Webmaster Tools OAuth (backlink verisi, kullaniciya ozel) ---
# https://www.bing.com/webmasters -> Settings -> API Access -> OAuth Client
# (API Key DEGIL) ile olusturun; Redirect URI olarak {APP_URL}/auth/bing/callback girin.
BING_CLIENT_ID=
BING_CLIENT_SECRET=

# Herhangi bir Google hesabi giris yapip hesap olusturabilir; yeni hesaplar
# admin onaylayana kadar panele erisemez (bkz. /admin/users). Buradaki
# e-postalar (virgulle ayrilmis) ilk giriste OTOMATIK admin + onayli sayilir
# - yeni kurulumda kendinize erisim acmak icindir, sonrasi /admin/users'tan
# yonetilir.
ADMIN_EMAILS=ornek@gmail.com
